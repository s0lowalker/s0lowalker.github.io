&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> $whitelist &lt;span style="color:#f92672">=&lt;/span> &lt;span style="color:#a6e22e">self&lt;/span>&lt;span style="color:#f92672">::&lt;/span>$goto_whitelist;
